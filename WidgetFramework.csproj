<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
	  <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WigiDashWidgetFramework</AssemblyName>
    <RootNamespace>WigiDashWidgetFramework</RootNamespace>
    <Version>1.0.0.1</Version>
    <Configurations>Debug;Release</Configurations>
    <Copyright>Copyright © ElmorLabs 2024</Copyright>
    <FileVersion>1.0.0.1</FileVersion>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Configuration -->
    <PackageId>victorperez2911.WigiDashWidgetFramework</PackageId>
    <Authors>Victor Perez</Authors>
    <Description>Framework for WigiDash Widgets</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/victorperez2911/WigiDashWidgetFramework</RepositoryUrl>
    <PackageTags>wigidash;widget;framework</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;Core</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;Core</DefineConstants>
  </PropertyGroup>
</Project>
